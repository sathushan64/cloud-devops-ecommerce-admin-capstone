<%- include('partials/header') %>

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-white">Product Inventory</h1>
    <p class="text-sm text-slate-400 mt-1">Manage and track inventory in real-time connected to AWS RDS.</p>
  </div>
  <a href="/products/new" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded-lg text-sm font-medium shadow transition">
    Create New Product
  </a>
</div>

<div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden shadow">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="bg-slate-900/60 uppercase text-xs text-slate-400 tracking-wider border-b border-slate-700">
        <tr>
          <th class="px-6 py-3">ID</th>
          <th class="px-6 py-3">Title</th>
          <th class="px-6 py-3">SKU</th>
          <th class="px-6 py-3">Category</th>
          <th class="px-6 py-3">Price</th>
          <th class="px-6 py-3">Stock</th>
          <th class="px-6 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-700">
        <% if (products.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-8 text-slate-400">No products found. Click "Create New Product" to add one.</td>
          </tr>
        <% } %>
        <% products.forEach(p => { %>
          <tr class="hover:bg-slate-700/40 transition">
            <td class="px-6 py-4 font-mono text-xs text-slate-400">#<%= p.id %></td>
            <td class="px-6 py-4 font-semibold text-white"><%= p.title %></td>
            <td class="px-6 py-4 font-mono text-xs text-indigo-300"><%= p.sku %></td>
            <td class="px-6 py-4">
              <span class="bg-slate-700 text-slate-300 px-2.5 py-0.5 rounded-full text-xs font-medium border border-slate-600">
                <%= p.category %>
              </span>
            </td>
            <td class="px-6 py-4 font-medium text-emerald-400">$<%= Number(p.price).toFixed(2) %></td>
            <td class="px-6 py-4">
              <% if (p.stock > 10) { %>
                <span class="text-slate-300"><%= p.stock %> in stock</span>
              <% } else if (p.stock > 0) { %>
                <span class="text-amber-400 font-medium"><%= p.stock %> low stock</span>
              <% } else { %>
                <span class="text-rose-400 font-medium">Out of stock</span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-right space-x-2">
              <a href="/products/<%= p.id %>/edit" class="text-indigo-400 hover:text-indigo-300 text-xs font-semibold">Edit</a>
              <form action="/products/<%= p.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                <button type="submit" class="text-rose-400 hover:text-rose-300 text-xs font-semibold">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>